# Application
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Database
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=finfreelance_user
DB_PASSWORD=CAMBIA_QUESTA_PASSWORD
DB_DATABASE=finfreelance
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Usata da docker-compose.prod.yml per MYSQL_ROOT_PASSWORD
DB_ROOT_PASSWORD=CAMBIA_QUESTA_PASSWORD_ROOT

# JWT — usa stringhe lunghe e random (es. openssl rand -base64 32)
JWT_SECRET=CAMBIA_QUESTO_SEGRETO
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=CAMBIA_QUESTO_REFRESH_SEGRETO
JWT_REFRESH_EXPIRES_IN=7d

# CORS — il dominio del frontend
CORS_ORIGIN=https://tuodominio.com

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
